# The database holds the family's calendar. It never belongs in the
# repository.
*.db
*.db-wal
*.db-shm
/data/

# The local configuration may hold addresses.
/agendouille.yaml

# Binaries.
/agendouille
/agendouille-*

# The compiled frontend. Built by `npm run build` and embedded by Go. The
# README.txt is committed because embed needs the directory to be non-empty.
internal/web/assets/static/app/*
!internal/web/assets/static/app/README.txt
internal/web/assets/static/admin/*
!internal/web/assets/static/admin/README.txt

node_modules/

# Android: the build, keys, and the APK the server embeds (built on
# dev-build or in CI, never committed).
android/build/
*.keystore
internal/web/assets/apk/*
!internal/web/assets/apk/README.txt
android/assets/web/*
!android/assets/web/index.html
!android/assets/web/icon.svg

# Claude Code worktrees and local settings.
.claude/

# The screenshot script links puppeteer from dev-build.
scripts/shots/node_modules
