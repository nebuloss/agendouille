[Unit]
Description=agendouille, the family calendar (CalDAV, web app, admin UI)
Documentation=https://github.com/nebuloss/agendouille
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agendouille
Group=agendouille
ExecStart=/usr/local/bin/agendouille serve -config /etc/agendouille.yaml

# A restore from the admin UI stages the backup and exits with 75; the
# restart applies it before the database opens. Without a restart, a
# restore stops the service.
Restart=on-failure
RestartSec=2s

StateDirectory=agendouille
StateDirectoryMode=0700

# The database holds the family's calendars and the hashes of every
# device password. The hardening below is not ceremonial.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=

# It only listens, and calls out to nothing: no outside service, ever.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Only the state directory is writable. If data_dir in
# /etc/agendouille.yaml points elsewhere, change this line too.
ReadWritePaths=/var/lib/agendouille
UMask=0077

# Ports above 1024, the defaults, need no capability. For 80 or 443:
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
