# agendouille behind nginx in the DMZ: forward ONLY the public listener
# (CalDAV and the family web app, :8791). Never the admin listener (:8792).
#
# In Nginx Proxy Manager: a proxy host to http://<agendouille>:8791 with
# "Websockets support" off, and the location block below pasted in the
# host's "Advanced" tab (NPM's own proxy.conf already sets Host and
# X-Forwarded-*).
#
# Then, in agendouille's admin UI (Settings, Network): public_url
# https://agenda.example.org, and trusted_proxies set to this proxy's
# address, so the activity log shows the family's addresses, not its.

server {
    listen 443 ssl;
    http2 on;
    server_name agenda.example.org;

    ssl_certificate     /etc/letsencrypt/live/agenda.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agenda.example.org/privkey.pem;

    # An imported .ics can be big; one event is small (max_object_bytes).
    client_max_body_size 20m;

    location / {
        proxy_pass http://10.0.60.8:8791;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # nginx passes every method (PROPFIND, REPORT, PROPPATCH,
        # MKCALENDAR, MKCOL, OPTIONS) and every header (Depth, If-Match,
        # If-None-Match, Authorization) by default: do not add a
        # limit_except or strip headers here.

        # /api/live is Server-Sent Events: no buffering, a long read. The
        # server also sends X-Accel-Buffering: no.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}

server {
    listen 80;
    server_name agenda.example.org;
    return 301 https://$host$request_uri;
}
