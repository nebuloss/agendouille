<?xml version="1.0" encoding="utf-8"?>
<!--
  The agendouille Android app (DECISIONS: the app is a sync app): its own
  screens (TypeScript, in the APK's assets) to sign the phone in and choose
  what syncs, an Android account holding the device's credential, and the
  CalDAV sync adapter that fills the phone's calendars. Built by android/Makefile, no Gradle. The Makefile fills
  @APP_LINKS@ with an App Link filter for the server's host when APP_HOST is
  set: an App Link names its host at build time, and each family runs its
  own server, so the agendouille:// scheme works with any server.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.nebuloss.agendouille">

  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Instant sync reconnects as soon as the network is back (PushService). -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.READ_CALENDAR" />
  <uses-permission android:name="android.permission.WRITE_CALENDAR" />
  <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
  <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
  <uses-permission android:name="android.permission.READ_SYNC_STATS" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- To ask, once, to be left out of battery optimisation: syncing in the
       background is the app's whole job (DAVx5 asks the same). -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <!-- To watch the phone's calendars again after a reboot (ChangeJob). -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- Updates from GitHub, installed through PackageInstaller (DECISIONS). -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <!-- Instant sync: a foreground service holds the push stream (its notification on the lowest channel). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <!-- As a UnifiedPush distributor: the apps it hands messages to (DAVx5, …). -->
  <queries>
    <intent>
      <action android:name="org.unifiedpush.android.connector.MESSAGE" />
    </intent>
    <intent>
      <action android:name="org.unifiedpush.android.connector.RAISE_TO_FOREGROUND" />
    </intent>
  </queries>

  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher"
      android:theme="@style/AppTheme"
      android:allowBackup="false"
      android:usesCleartextTraffic="@USES_CLEARTEXT@"
      android:supportsRtl="true">

    <activity
        android:name=".MainActivity"
        android:label="@string/launcher_name"
        android:exported="true"
        android:launchMode="singleTask"
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!-- agendouille://enroll?u=<the enrollment link>: any server. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="agendouille" android:host="enroll" />
      </intent-filter>
@APP_LINKS@
    </activity>

    <service
        android:name=".SyncService"
        android:exported="true"
        android:permission="android.permission.BIND_SYNC_ADAPTER">
      <intent-filter>
        <action android:name="android.content.SyncAdapter" />
      </intent-filter>
      <meta-data
          android:name="android.content.SyncAdapter"
          android:resource="@xml/syncadapter" />
    </service>

    <!-- Instant sync: the push stream, while the person has it on. -->
    <service
        android:name=".PushService"
        android:exported="false"
        android:foregroundServiceType="specialUse">
      <property
          android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="Holds the connection to the family's own push server (a UnifiedPush distributor), in place of Google's" />
    </service>
    <!-- The app as a UnifiedPush distributor: DAVx5 and others register here. -->
    <receiver android:name=".Distributor$Receiver" android:exported="true">
      <intent-filter>
        <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        <action android:name="org.unifiedpush.android.distributor.UNREGISTER" />
        <action android:name="org.unifiedpush.android.distributor.MESSAGE_ACK" />
      </intent-filter>
    </receiver>

    <!-- An event changed on the phone goes to the server within seconds. -->
    <service
        android:name=".ChangeJob"
        android:exported="false"
        android:permission="android.permission.BIND_JOB_SERVICE" />
    <receiver android:name=".ChangeJob$Boot" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>

    <service
        android:name=".AuthenticatorService"
        android:exported="true"
        android:permission="android.permission.ACCOUNT_MANAGER">
      <intent-filter>
        <action android:name="android.accounts.AccountAuthenticator" />
      </intent-filter>
      <meta-data
          android:name="android.accounts.AccountAuthenticator"
          android:resource="@xml/authenticator" />
    </service>
  </application>
</manifest>
